# Porta HTTP do serviço de transcrição (8080 é o default da Evolution API)
PORT=8090

# Token compartilhado com o backend (recomendado). Se definido, o backend deve
# enviar o header x-api-token com o mesmo valor.
TRANSCRIPTION_API_TOKEN=

# Binário do whisper.cpp. No container já vem em /usr/local/bin/whisper-cli (PATH).
# No Windows, aponte para o whisper-cli.exe baixado (npm run setup:binaries).
WHISPER_BIN=whisper-cli

# Nome do modelo GGML (resolvido para ./models/<nome>). Padrão: small.
WHISPER_MODEL=ggml-small.bin

# Idioma fixo do negócio. Use "auto" para autodetecção.
WHISPER_LANGUAGE=pt

# Threads do whisper.cpp (padrão: nº de CPUs)
# WHISPER_THREADS=4

# Binário do ffmpeg (converte o áudio p/ WAV 16kHz mono). "ffmpeg" se no PATH.
FFMPEG_BIN=ffmpeg

# Jobs processados em paralelo (whisper.cpp é pesado de CPU → 1 é seguro)
QUEUE_CONCURRENCY=1

# Limite do áudio recebido, em bytes (padrão 25MB)
# MAX_AUDIO_BYTES=26214400
